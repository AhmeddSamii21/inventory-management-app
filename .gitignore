# Dependency folders — these can be re-created with "npm install",
# so we never save them in Git history.
node_modules/

# Database files (they contain live data, not code)
backend/*.db
backend/*.sqlite3

# Frontend build output (generated by "npm run build")
frontend/dist/

# Environment/secret files
.env
.env.local

# Operating system junk
Thumbs.db
.DS_Store

# Log files
npm-debug.log*
*.log
